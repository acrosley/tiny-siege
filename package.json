{
  "name": "tiny-siege",
  "version": "1.1.0",
  "private": true,
  "description": "A fortress duel for two friends, locally or online.",
  "scripts": {
    "test": "node --test tests/engine.test.cjs tests/rooms.test.cjs",
    "build": "node scripts/build-site.cjs && node scripts/build.cjs",
    "start": "node scripts/serve.cjs",
    "test:browser": "npx playwright test",
    "format": "prettier --write index.html style.css app.js scene.js engine.js scripts/*.cjs tests/**/*.cjs playwright.config.cjs",
    "build:release": "node scripts/build.cjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.cjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
